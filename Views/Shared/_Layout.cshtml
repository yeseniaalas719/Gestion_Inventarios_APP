<!DOCTYPE html>
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Gestión de inventario</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>

<body>
    <style>
        .header {
            background: #748DAE;
            border-bottom: 3px solid #5E7AC4;
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .logo {
            color: #fff;
            font-size: 24px;
            font-weight: bold;
            text-decoration: none;
        }

        .nav {
            display: flex;
            gap: 20px;
            list-style: none;
            margin: 0;
            padding: 0;
        }

            .nav a {
                color: #bdc3c7;
                text-decoration: none;
                font-size: 16px;
                transition: color 0.3s;
            }


        @@media (max-width: 600px) {
            .header {
                flex-direction: column;
                gap: 15px;
                padding: 20px;
            }

            .nav {
                flex-direction: column;
                text-align: center;
                gap: 15px;
                width: 100%;
            }
        }
    </style>

    <header class="header">
        <a href="/Home/Index" class="logo">📦Gestion de Inventarios App</a>

        <ul class="nav">
            <li><a href="/Home/Index">Inicio</a></li>
        </ul>
    </header>
    <div class="container body-content">
        @RenderBody()
    </div>

    <footer style="background-color: #748DAE; color: #ecf0f1; padding: 10px 0; text-align: center; margin-top: 50px; border-top: 3px solid #5E7AC4; border-radius: 0 0 0 0; ">
        <div style="max-width: 100%; margin: 0 auto;">
            <p style="margin: 0; font-size: 16px; font-weight: bold; letter-spacing: 0.5px;">
                &copy; 2026 - Desarrollado por Yesenia Alas
            </p>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
