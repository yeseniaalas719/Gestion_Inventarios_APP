@model IEnumerable<Gestion_Inventarios_APP.Models.Producto>

@{
    ViewBag.Title = "Inventario";
}

<h4>Panel de Control de Artículos</h4>


<div style="margin-bottom: 20px; padding: 15px; border: 1px solid #ccc; border-radius: 5px;">
    <form action="/Home/Guardar" method="post">
        <label>Nombre del artículo:</label>
        <input type="text" name="nombre" required style="margin-right: 15px; padding: 5px;" />

        <label>Cantidad:</label>
        <input type="number" name="cantidad" required min="1" style="margin-right: 15px; padding: 5px; width: 80px;" />

        <button type="submit"
                style="padding: 6px 15px; background-color: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer;"
                onclick="return confirm('¿Confirmar registro?\n\nArtículo: ' + document.getElementsByName('nombre')[0].value + '\nCantidad: ' + document.getElementsByName('cantidad')[0].value);">
            Agregar al Inventario
        </button>
    </form>
</div>

<div class="row mt-2 mb-3">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header text-black py-1" style="background-color:#f2f2f2;">
                <h6 class="mb-0">Análisis de Stock</h6>
            </div>
            <div class="card-body" style="height: 220px; padding: 10px;">
                <canvas id="graficoBarras"></canvas>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header text-black py-1" style="background-color:#f2f2f2;">
                <h6 class="mb-0">Distribución %</h6>
            </div>
            <div class="card-body" style="height: 220px; padding: 10px;">
                <canvas id="graficoDona"></canvas>
            </div>
        </div>
    </div>
</div>

<table border="1" cellpadding="8" style="border-collapse: collapse; width: 100%; text-align: left;">
    <thead>
        <tr style="background-color: #f2f2f2;">
            <th style="padding: 10px;">ID</th>
            <th style="padding: 10px;">Nombre del Artículo</th>
            <th style="padding: 10px;">Cantidad en Stock</th>
            <th style="padding: 10px;">Fecha de Registro</th>
            <th style="padding: 10px;">Acciones</th>

        </tr>
    </thead>

    <tbody>

        @if (Model != null)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>

                    @if (ViewBag.IdEditar == item.Id)
                    {
                        using (Html.BeginForm("Actualizar", "Home", FormMethod.Post))
                        {
                            @Html.Hidden("Id", item.Id)
                            <td><input type="text" name="Nombre" value="@item.Nombre" required /></td>
                            <td><input type="number" name="Cantidad" value="@item.Cantidad" required min="1" /></td>
                            <td>
                                <button type="submit"
                                        style="color: green; font-weight: bold; border: none; background: none; cursor: pointer;"
                                        onclick="return confirm('¿Deseas guardar los cambios realizados?\n\nNuevo Nombre: ' + document.getElementsByName('Nombre')[0].value + '\nNueva Cantidad: ' + document.getElementsByName('Cantidad')[0].value);">
                                    Guardar
                                </button>
                                <a href="@Url.Action("Index")" style="color: gray;">Cancelar</a>
                            </td>
                        }
                    }
                    else
                    {
                        <td>@item.Nombre</td>
                        <td>@item.Cantidad</td>
                        <td>@item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <a href="@Url.Action("Index", new { idEditar = item.Id })" style="color: #007bff;">Editar</a>

                            |

                            @using (Html.BeginForm("Eliminar", "Home", FormMethod.Post, new { style = "display:inline;" }))
                            {
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" style="background:none; border:none; color:red; cursor:pointer;" onclick="return confirm('¿Eliminar este artículo?')">
                                    Eliminar
                                </button>
                            }
                        </td>
                    }
                </tr>
            }
        }
    </tbody>
</table>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const etiquetasJS = @Html.Raw(ViewBag.EtiquetasJSON);
    const valoresJS = @Html.Raw(ViewBag.ValoresJSON);

    const coloresPalette = ['#007bff', '#28a745', '#ffc107', '#dc3545', '#6f42c1', '#17a2b8'];

    const ctxB = document.getElementById('graficoBarras').getContext('2d');
    new Chart(ctxB, {
        type: 'bar',
        data: {
            labels: etiquetasJS,
            datasets: [{
                label: 'Cantidad disponible',
                data: valoresJS,
                backgroundColor: coloresPalette
            }]
        },
        options: { responsive: true, maintainAspectRatio: false }
    });

    const ctxD = document.getElementById('graficoDona').getContext('2d');
    new Chart(ctxD, {
        type: 'doughnut',
        data: {
            labels: etiquetasJS,
            datasets: [{
                data: valoresJS,
                backgroundColor: coloresPalette
            }]
        },
        options: { responsive: true, maintainAspectRatio: false }
    });
</script>


