@model IEnumerable<Gestion_Inventarios_APP.Models.Producto>

@{
    ViewBag.Title = "Inventario";
}

<h4>Panel de Control de Artículos</h4>

<div style="margin-bottom: 20px; padding: 15px; border: 1px solid #ccc; border-radius: 5px;">
    <form action="/Home/Guardar" method="post">
        <label>Nombre del artículo:</label>
        <input type="text" name="nombre" required style="margin-right: 15px; padding: 5px;" />

        <label>Cantidad:</label>
        <input type="number" name="cantidad" required min="1" style="margin-right: 15px; padding: 5px; width: 80px;" />

        <button type="submit" style="padding: 6px 15px; background-color: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer;">
            Agregar al Inventario
        </button>
    </form>
</div>

<table border="1" cellpadding="8" style="border-collapse: collapse; width: 100%; text-align: left;">
    <tr style="background-color: #f2f2f2;">
        <th>ID</th>
        <th>Nombre del Artículo</th>
        <th>Cantidad en Stock</th>
    </tr>

    @if (Model != null)
    {
        foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>

                @if (ViewBag.IdEditar == item.Id)
                {
                    using (Html.BeginForm("Actualizar", "Home", FormMethod.Post))
                    {
                        @Html.Hidden("Id", item.Id)
                        <td><input type="text" name="Nombre" value="@item.Nombre" required /></td>
                        <td><input type="number" name="Cantidad" value="@item.Cantidad" required min="1" /></td>
                        <td>
                            <button type="submit" style="color: green; font-weight: bold;">Guardar</button> |
                            <a href="@Url.Action("Index")" style="color: gray;">Cancelar</a>
                        </td>
                    }
                }
                else
                {
                    <td>@item.Nombre</td>
                    <td>@item.Cantidad</td>
                    <td>
                        <a href="@Url.Action("Index", new { idEditar = item.Id })" style="color: #007bff;">Editar</a>

                        |

                        @using (Html.BeginForm("Eliminar", "Home", FormMethod.Post, new { style = "display:inline;" }))
                        {
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" style="background:none; border:none; color:red; cursor:pointer;" onclick="return confirm('¿Eliminar este artículo?')">
                                Eliminar
                            </button>
                        }
                    </td>
                }
            </tr>
        }
    }
</table>

